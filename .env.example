# 应用配置
APP_NAME=One Take API
VERSION=2.0.0
DEBUG=false

# 存储配置
STORAGE_PATH=./storage
MAX_FILE_SIZE=524288000

# ASR 配置
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# FFmpeg 配置（AVI 硬字幕要求 libass/subtitles 滤镜）
# macOS: brew install ffmpeg-full；改为 $(brew --prefix ffmpeg-full)/bin/ffmpeg 的实际路径
FFMPEG_PATH=ffmpeg

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./storage/onetake.db
